<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules for Android 11 and below (fullBackupContent).

  The "musicarr_session" DataStore holds the session cookie in plain text. Left
  in the backup set it would be copied to Google's servers and restored onto any
  device the user sets up, so a live credential travels well outside the phone
  it was issued to. Exclude it; the server URL lives in the same file, so the
  cost is re-entering the address and signing in again after a restore.

  "offline-audio" is the pinned-track store. It lives in getExternalFilesDir()
  rather than a cache dir (the OS must not reclaim what the user pinned for a
  flight), and app-specific external files ARE backed up by default — so
  without this exclusion an entire offline music library, potentially many
  gigabytes, would be uploaded to the user's cloud backup. The audio is
  re-downloadable from the server, so there is nothing to preserve here.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/musicarr_session.preferences_pb" />
    <exclude domain="external" path="offline-audio" />
</full-backup-content>
